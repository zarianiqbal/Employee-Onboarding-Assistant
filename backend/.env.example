# Example environment configuration for local development.
# Copy to `.env` (git-ignored) and adjust. In Azure these are set as App
# Service application settings; there are NO secrets here — only endpoints.
# Authentication uses managed identity (in Azure) or `az login` (locally).

# Leaving Azure endpoints blank runs the backend in "local" mode with an
# in-memory data store and a stubbed AI assistant — handy for UI development.

APP_ENV=local
LOG_LEVEL=INFO

# CORS: comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Azure SQL (blank -> in-memory store) ---
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=

# --- Azure Blob Storage (blank -> stubbed SAS tokens) ---
AZURE_STORAGE_ACCOUNT_URL=
POLICIES_CONTAINER=company-policies
DOCUMENTS_CONTAINER=employee-documents

# --- Azure OpenAI (blank -> stubbed chat responses) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embeddings
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Search (blank -> keyword stub) ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=onboarding-policies
